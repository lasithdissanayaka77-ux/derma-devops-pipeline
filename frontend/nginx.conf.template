# nginx replaces ${BACKEND_HOST} at container start; nginx's own $variables are left alone.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 20m;   # skin-image uploads

  # API  ->  backend container.  The trailing "/" strips the "/api" prefix.
  # ADJUST: if your backend routes already start with /api, use:  proxy_pass http://${BACKEND_HOST}:8000;
  location /api/ {
    proxy_pass http://${BACKEND_HOST}:8000/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # WebSocket chat  (ADJUST the path to whatever your chat endpoint uses)
  location /ws/ {
    proxy_pass http://${BACKEND_HOST}:8000/ws/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
  }

  # Uploaded images  (ADJUST or delete if the backend serves them elsewhere)
  location /media/ {
    proxy_pass http://${BACKEND_HOST}:8000/media/;
  }

  # Prometheus metrics are internal only - never expose them to the internet
  location = /metrics { return 404; }

  # Single-page-app fallback
  location / {
    try_files $uri $uri/ /index.html;
  }
}
